<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>OPCClient</RootNamespace>
    <AssemblyName>OPCClient</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Feste Versionen statt Wildcards: reproduzierbare Builds -->
    <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua" Version="1.5.378.182" />
    <PackageReference Include="System.Reactive" Version="6.0.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.31" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OPCClient.Tests" />
  </ItemGroup>

</Project>
