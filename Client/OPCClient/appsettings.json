        "UseSecurity": false,
        "Nodes": [
          { "Name": "Temperatur", "NodeId": "ns=2;s=Temperatur" },
          { "Name": "Status", "NodeId": "ns=2;s=Status" }
        ]
      }
    ]
  }
}
