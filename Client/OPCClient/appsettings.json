{
  "Urls": "http://localhost:5080",
  "Database": {
    "Path": "opc.db"
  },
  "Retention": {
    "DoneRetentionDays": 7,
    "AlarmRetentionDays": 30,
    "AuditRetentionDays": 90,
    "IntervalMinutes": 60
  },
  "Opc": {
    "HandlerTimeoutSeconds": 5,
    "AutoAcceptUntrustedCertificates": false,
    "Sink": {
      "Type": "Log",
      "WebhookUrl": ""
    },
    "Machines": [
      {
        "Name": "Presse-1",
        "Endpoint": "opc.tcp://localhost:4840",
        "UseSecurity": false,
        "Nodes": [
          {
            "Name": "Temperatur",
            "NodeId": "ns=2;s=Presse-1.Temperatur",
            "Limits": {
              "Low": 10,
              "High": 80
            }
          },
          {
            "Name": "Drehzahl",
            "NodeId": "ns=2;s=Presse-1.Drehzahl",
            "Limits": {
              "High": 1600
            }
          },
          {
            "Name": "Status",
            "NodeId": "ns=2;s=Presse-1.Status"
          },
          {
            "Name": "Stueckzahl",
            "NodeId": "ns=2;s=Presse-1.Stueckzahl"
          }
        ]
      },
      {
        "Name": "Drehbank-2",
        "Endpoint": "opc.tcp://localhost:4840",
        "UseSecurity": false,
        "Nodes": [
          {
            "Name": "Temperatur",
            "NodeId": "ns=2;s=Drehbank-2.Temperatur",
            "Limits": {
              "Low": 10,
              "High": 80
            }
          },
          {
            "Name": "Drehzahl",
            "NodeId": "ns=2;s=Drehbank-2.Drehzahl",
            "Limits": {
              "High": 1600
            }
          },
          {
            "Name": "Status",
            "NodeId": "ns=2;s=Drehbank-2.Status"
          },
          {
            "Name": "Stueckzahl",
            "NodeId": "ns=2;s=Drehbank-2.Stueckzahl"
          }
        ]
      }
    ]
  },
  "RateLimit": {
    "RequestsPerMinute": 120,
    "McpRequestsPerMinute": 30
  }
}
